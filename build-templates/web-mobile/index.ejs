<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <title><%= projectName %></title>

  <!--http://www.html5rocks.com/en/mobile/mobifying/-->
  <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>

  <!--https://developer.apple.com/library/safari/documentation/AppleApplications/Reference/SafariHTMLRef/Articles/MetaTags.html-->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">

  <!-- force webkit on 360 -->
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <!-- force edge on IE -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">

  <!-- force full screen on some browser -->
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>

  <meta name="x5-page-mode" content="app">
  <meta name="mobile-web-app-capable" content="yes">
  <link rel="manifest" href="manifest.webmanifest">

  <!-- <script src="https://cdn.jsdelivr.net/npm/eruda"></script> -->

  <style type='text/css'>
    html {
      -ms-touch-action: none;
    }

    body, canvas, div {
      display: block;
      outline: none;
      -webkit-tap-highlight-color: rgba(0, 0, 0, 0);

      user-select: none;
      -moz-user-select: none;
      -webkit-user-select: none;
      -ms-user-select: none;
      -khtml-user-select: none;
      -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    }

    /* Remove spin of input type number */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    html, body {
      overflow: hidden;
      overscroll-behavior: none;
    }
    #GameDiv, #GameCanvas, #Cocos3dGameContainer, .loader-container {
      touch-action: none;
      overscroll-behavior: none;
      -webkit-touch-callout: none;
    }
    :root {
      --gesture-edge: 0px;
      --gesture-bottom: 0px;
    }
    @media (any-pointer: coarse) {
      :root {
        --gesture-edge: 24px;
        --gesture-bottom: 28px;
      }
    }
    body {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      padding: 0;
      border: 0;
      margin: 0;

      cursor: default;
      color: #888;
      background-color: #333;

      text-align: center;
      font-family: Helvetica, Verdana, Arial, sans-serif;

      display: flex;
      flex-direction: column;
    }

    canvas {
      background-color: rgba(0, 0, 0, 0);
    }

    #GameDiv, .loader-container {
      position: absolute;
      left: var(--game-left, 0px);
      top: var(--game-top, 0px);
      width: var(--game-width, 100%);
      height: var(--game-height, 100dvh);
      transform: var(--game-transform, none) !important;
      transform-origin: 0 0 !important;
      margin: 0 !important;
      overflow: hidden;
    }

    #Cocos3dGameContainer, #GameCanvas {
      width: 100%;
      height: 100%;
    }

    :root {
      --safe-top: env(safe-area-inset-top);
      --safe-right: env(safe-area-inset-right);
      --safe-bottom: env(safe-area-inset-bottom);
      --safe-left: env(safe-area-inset-left);
    }

    .loader-container {
      z-index: 3;
    }
    .loading-bg {
      width: 100%;
      height: 100%;
      position: absolute;
      background-image: url(styles/background.webp);
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }
    .logo-container {
      width: 100%;
      height: 100%;
      position: absolute;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      gap: 24px;
    }
    .logo-img {
      width: min(28vw, 210px);
      height: auto;
      object-fit: contain;
    }
    .loader {
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #5db4ff 0%, #2f81de 100%) 0 / 0% no-repeat transparent;
      position: relative;
    }
    .loader-hide
    {
      opacity: 0;
      transition: 1.5s;
    }
    #fullscreen-toggle {
      position: absolute;
      left: calc(var(--game-left, 0px) + 12px + var(--safe-left, 0px));
      bottom: calc(12px + var(--safe-bottom, 0px));
      z-index: 4;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 12px;
      display: none;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: rgba(40, 30, 20, 0.55);
      cursor: pointer;
    }
    #fullscreen-toggle:hover { background: rgba(40, 30, 20, 0.75); }
    #fullscreen-toggle:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .progress-container {
      width: min(62vw, 460px);
      height: 26px;
      position: relative;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.88);
      box-shadow: 0 8px 24px rgba(34, 60, 80, 0.35);
      overflow: hidden;
    }
  </style>

</head>
<body>
  <script src="viewport.js"></script>
  <script src="gestures.js"></script>
  <script src="fullscreen.js"></script>
  <div id="GameDiv" cc_exact_fit_screen="false">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
    </div>
  </div>
  <div id="loader-container" class="loader-container">
    <div class="loading-bg"></div>
    <div class="logo-container">
      <img id="logo" class="logo-img" src="styles/logo.webp"/>
      <div class="progress-container">
        <div id="progress-bar" class="loader"></div>
      </div>
    </div>
  </div>
  
 <script>
    /**
     * ДИНАМИЧЕСКОЕ ПОДКЛЮЧЕНИЕ SDK
     * Анализируем URL-адрес фрейма до старта Cocos Creator
     */
    (function() {
      const search = window.location.search;
      const host = window.location.hostname;
      let sdkScript = document.createElement('script');

      if (search.includes('vk_') || search.includes('tgWebAppPlatform')) {
        // ТЕПЕРЬ ТОЧНО ИЗМЕНЕНО: Ссылка ведет напрямую на JS-файл моста, а не на корень unpkg
        sdkScript.src = "https://unpkg.com/@vkontakte/vk-bridge/dist/browser.min.js";
        console.log("### Template: VK platform detected, loading VK Bridge...");
      } else if (host.includes('yandex')) {
        sdkScript.src = "/sdk.js";
        console.log("### Template: Yandex platform detected, loading Yandex SDK...");
      } else {
        console.log("### Template: dev/web platform, SDK not loaded");
        return;
      }
      document.body.appendChild(sdkScript);
    })();
  </script>

  <script>
    //eruda.init();
    
    let progressBar = document.getElementById("progress-bar");
    let fakeProgress = 0;
    let fakeProgressIsFull = false;
    let fakeProgressTimer = setInterval(updateFakeProgress, 300);

    function updateFakeProgress()
    {
      if (fakeProgressIsFull)
      {
        clearInterval(fakeProgressTimer);
      }
      else
      {
        fakeProgress = Math.min(fakeProgress + 2, 25);
        fakeProgressIsFull = fakeProgress >= 25;
        progressBar.style.setProperty("background-size", fakeProgress + "%");
      }
    }

    window.stopFakeProgress = () =>
    {
      clearInterval(fakeProgressTimer);
    }

    window.setProgressFromCocos = (value) =>
    {
      const mapped = 25 + value * 0.65;
      progressBar.style.setProperty("background-size", mapped + "%");
    }

    window.hideLoader = function(onRemoved)
    {
      const loaderContainer = document.getElementById("loader-container");
      loaderContainer.classList.add("loader-hide");

      const onTransitionEnd = () => {
        loaderContainer.removeEventListener("transitionend", onTransitionEnd);
        removeLoader();
        if (onRemoved) onRemoved();
      };
      loaderContainer.addEventListener("transitionend", onTransitionEnd);

      setTimeout(() => {
        if (document.getElementById("loader-container")) {
          removeLoader();
          if (onRemoved) onRemoved();
        }
      }, 500);
    }
    
    function removeLoader()
    {
      document.getElementById("loader-container").remove();
    }
  </script>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
